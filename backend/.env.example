# ==============================================================================
# Pax Virentia Backend Environment Configuration Template
# Copy this file to backend/.env and fill in your values
# ==============================================================================

PROJECT_NAME="Pax Virentia API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
CODE_VERSION="0.1.0-dev"

# Database Connection:
# - Local SQLite (zero-setup default): sqlite:///pax_virentia.db
# - Supabase / Neon PostgreSQL: postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Allowed CORS Origins
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173"]

# Session Security
SECRET_KEY="dev-secret-key-change-in-production-min-32-chars-long"
SESSION_LIFETIME_HOURS=24
SESSION_REMEMBER_HOURS=720

# Optional Supabase API Keys
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini API Key (leave empty to use deterministic template fallbacks)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Initial Seed Analyst User
SEED_USER_EMAIL="ana.santos@example.com"
SEED_USER_PASSWORD="pax-virentia-dev"
SEED_USER_NAME="Ana Santos"
SEED_USER_ROLE="analyst"
